<%- include('partials/top') %>

<section class="admin-page-head">
  <div>
    <p class="admin-eyebrow">CONTENT / <%= section.key.toUpperCase() %></p>
    <h1><%= section.title %></h1>
    <p><%= section.description %></p>
  </div>
  <div class="admin-page-head__actions">
    <% if (section.key === 'activities') { %>
    <a class="admin-btn" href="/admin/activities/bulk">批量添加</a>
    <% } %>
    <a class="admin-btn admin-btn--primary" href="/admin/<%= section.key %>/new">+ 新增<%= section.singular %></a>
  </div>
</section>

<div class="admin-toolbar">
  <form method="get" action="/admin/<%= section.key %>" class="admin-search">
    <input type="search" name="q" value="<%= q %>" placeholder="搜索<%= section.singular %>…">
    <button class="admin-btn" type="submit">搜索</button>
    <% if (q) { %><a class="admin-linkbtn" href="/admin/<%= section.key %>">清空</a><% } %>
  </form>
  <span class="admin-toolbar__count">共 <b><%= total %></b> 条</span>
</div>

<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <% section.columns.forEach((key) => { const field = section.fields.find((item) => item.key === key); %>
        <th><%= field ? field.label : key %></th>
        <% }) %>
        <th class="admin-table__actions">操作</th>
      </tr>
    </thead>
    <tbody>
      <% if (!rows.length) { %>
      <tr>
        <td colspan="<%= section.columns.length + 1 %>" class="admin-empty">
          <p>没有找到内容。</p>
          <a class="admin-btn admin-btn--primary" href="/admin/<%= section.key %>/new">+ 新增<%= section.singular %></a>
        </td>
      </tr>
      <% } %>
      <% rows.forEach((row) => { %>
      <% const label = row.item.name || row.item.title || row.item.keyword || '这条记录'; %>
      <tr>
        <% row.cells.forEach((cell) => { %>
        <td>
          <% if (cell.field.type === 'image') { %>
            <% if (cell.value) { %>
            <a href="<%= cell.value %>" target="_blank" rel="noopener">
              <img class="admin-thumb" src="<%= cell.thumb %>" alt="" loading="lazy">
            </a>
            <% } else { %>
            <span class="admin-muted">未设置</span>
            <% } %>
          <% } else if (cell.field.type === 'url') { %>
            <% if (cell.value) { %>
            <a class="admin-truncate" href="<%= cell.value %>" target="_blank" rel="noopener" title="<%= cell.value %>"><%= cell.text %></a>
            <% } else { %>
            <span class="admin-muted">未设置</span>
            <% } %>
          <% } else { %>
            <span class="admin-truncate" title="<%= cell.value %>"><%= cell.text %></span>
          <% } %>
        </td>
        <% }) %>
        <td class="admin-table__actions">
          <a class="admin-btn admin-btn--small" href="/admin/<%= section.key %>/<%= row.index %>/edit">编辑</a>
          <form method="post" action="/admin/<%= section.key %>/<%= row.index %>/delete" data-confirm="确定删除「<%= label %>」？此操作不可撤销。">
            <button class="admin-btn admin-btn--small admin-btn--danger" type="submit">删除</button>
          </form>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<% if (total) { %>
<div class="admin-pagination">
  <span>显示 <%= start + 1 %>–<%= end %> / <%= total %></span>
  <div class="admin-pagination__pages">
    <% if (page > 1) { %>
    <a class="admin-btn admin-btn--small" href="<%= pageHref(page - 1) %>">上一页</a>
    <% } %>
    <span>第 <%= page %> / <%= pageCount %> 页</span>
    <% if (page < pageCount) { %>
    <a class="admin-btn admin-btn--small" href="<%= pageHref(page + 1) %>">下一页</a>
    <% } %>
  </div>
</div>
<% } %>

<%- include('partials/bottom') %>
