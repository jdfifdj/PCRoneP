<%- include('partials/top') %>

<section class="admin-page-head">
  <div>
    <p class="admin-eyebrow"><%= mode === 'create' ? 'CREATE' : 'EDIT' %> / <%= section.key.toUpperCase() %></p>
    <h1><%= title %></h1>
    <p><%= section.description %></p>
  </div>
  <div class="admin-page-head__actions">
    <a class="admin-btn" href="/admin/<%= section.key %>">← 返回列表</a>
  </div>
</section>

<% if (Object.keys(errors).length) { %>
<div class="admin-alert admin-alert--error">有 <%= Object.keys(errors).length %> 项内容需要修正，请检查标红字段。</div>
<% } %>

<form class="admin-form" method="post" action="<%= action %>">
  <div class="admin-form__fields">
    <%- include('partials/fields', { fields: section.fields, values, errors, imageOptions }) %>
  </div>

  <div class="admin-form__actions">
    <button class="admin-btn admin-btn--primary" type="submit"><%= mode === 'create' ? '创建' : '保存修改' %></button>
    <a class="admin-btn" href="/admin/<%= section.key %>">取消</a>
  </div>
</form>

<% if (mode === 'edit') { %>
<form class="admin-danger-zone" method="post" action="/admin/<%= section.key %>/<%= action.split('/').pop() %>/delete"
      data-confirm="确定删除这条<%= section.singular %>？此操作不可撤销。">
  <div>
    <b>删除<%= section.singular %></b>
    <span>删除后前台页面会立即移除这条内容。</span>
  </div>
  <button class="admin-btn admin-btn--danger" type="submit">删除</button>
</form>
<% } %>

<%- include('partials/bottom') %>
