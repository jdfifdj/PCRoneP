<%- include('partials/top') %>

<section class="admin-page-head">
  <div>
    <p class="admin-eyebrow">CONTENT / ACTIVITIES / BULK</p>
    <h1>批量添加活动</h1>
    <p>粘贴一个或多个活动对象，解析成功后一次性加入「重要活动」。支持旧版配置格式。</p>
  </div>
  <div class="admin-page-head__actions">
    <a class="admin-btn" href="/admin/activities">← 返回活动列表</a>
  </div>
</section>

<div class="admin-columns">
  <section class="admin-panel">
    <header class="admin-panel__head"><h2>粘贴数据</h2></header>
    <div class="admin-panel__body">
      <% if (errors.length) { %>
      <div class="admin-alert admin-alert--error">
        <p>没有写入任何数据，请修正以下问题：</p>
        <ul class="admin-errors">
          <% errors.forEach((error) => { %><li><%= error %></li><% }) %>
        </ul>
      </div>
      <% } %>

      <form method="post" action="/admin/activities/bulk" class="admin-bulk-form">
        <div class="admin-field">
          <label for="bulk-payload">活动数据</label>
          <textarea id="bulk-payload" name="payload" rows="18" spellcheck="false" placeholder="{ ... }, { ... }"><%= payload %></textarea>
        </div>
        <div class="admin-form__actions">
          <button class="admin-btn admin-btn--primary" type="submit">解析并批量添加</button>
          <a class="admin-btn" href="/admin/activities">取消</a>
        </div>
      </form>
    </div>
  </section>

  <section class="admin-panel">
    <header class="admin-panel__head"><h2>格式说明</h2></header>
    <div class="admin-panel__body">
      <p class="admin-hint">可以粘贴一个对象、多个用逗号分隔的对象，或 JSON 数组。</p>
      <pre class="admin-example">{
  "name": "「高难关卡」装备掉落量 6 倍、玛那掉落量 4 倍庆典",
  "start": "2026/11/13 11:00",
  "end": "2026/11/30 10:59",
  "shouldShow": true,
  "icon": "./图标/困难关卡.png"
},
{
  "name": "「普通关卡」装备掉落量 6 倍、玛那掉落量 4 倍庆典",
  "start": "2026/11/13 11:00",
  "end": "2026/11/30 10:59",
  "shouldShow": true,
  "icon": "./图标/主线关卡.png"
}</pre>
      <ul class="admin-bulk-notes">
        <li><code>icon</code> 中的 <code>./图标/xxx.png</code> 会自动转换为 <code>/images/icons/xxx.png</code>。</li>
        <li>时间支持 <code>2026/11/13 11:00</code>、<code>2026-11-13T11:00</code>、ISO 8601。</li>
        <li><code>shouldShow</code> 和其他旧字段会被忽略。</li>
        <li>重复活动（名称 + 时间 + 图标相同）会自动跳过。</li>
        <li>任何一条格式错误时都不会写入，避免只导入一半。</li>
      </ul>
    </div>
  </section>
</div>

<%- include('partials/bottom') %>
