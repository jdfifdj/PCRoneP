<%- include('partials/top') %>

<section class="admin-page-head">
  <div>
    <p class="admin-eyebrow">SITE / ADMIN ACCOUNTS</p>
    <h1>管理员账号</h1>
    <p>每个账号使用独立密码。连续输错 <%= lockAfter %> 次密码后，账号会被锁定 1 小时；重置密码可立即解除锁定。</p>
  </div>
</section>

<section class="admin-panel">
  <header class="admin-panel__head"><h2>添加账号</h2></header>
  <div class="admin-panel__body">
    <% if (Object.keys(errors).length) { %>
    <div class="admin-alert admin-alert--error">请检查标红的字段。</div>
    <% } %>
    <form method="post" action="/admin/accounts" class="admin-account-create">
      <div class="admin-field<%= errors.username ? ' has-error' : '' %>">
        <label for="new-account-username">用户名</label>
        <input id="new-account-username" type="text" name="username" value="<%= values.username || '' %>"
               placeholder="3–30 位" required minlength="3" maxlength="30" autocomplete="off">
        <% if (errors.username) { %><p class="admin-error"><%= errors.username %></p><% } %>
      </div>
      <div class="admin-field<%= errors.password ? ' has-error' : '' %>">
        <label for="new-account-password">密码</label>
        <input id="new-account-password" type="password" name="password" placeholder="至少 8 位" required minlength="8" maxlength="200" autocomplete="new-password">
        <% if (errors.password) { %><p class="admin-error"><%= errors.password %></p><% } %>
      </div>
      <div class="admin-field<%= errors.confirm ? ' has-error' : '' %>">
        <label for="new-account-confirm">确认密码</label>
        <input id="new-account-confirm" type="password" name="confirm" placeholder="再次输入" required minlength="8" maxlength="200" autocomplete="new-password">
        <% if (errors.confirm) { %><p class="admin-error"><%= errors.confirm %></p><% } %>
      </div>
      <div class="admin-account-create__action">
        <button class="admin-btn admin-btn--primary" type="submit">+ 添加账号</button>
      </div>
    </form>
  </div>
</section>

<section class="admin-accounts">
  <% accounts.forEach((account) => { %>
  <article class="admin-account<%= account.isCurrent ? ' is-current' : '' %>">
    <header class="admin-account__head">
      <div>
        <h2><%= account.username %></h2>
        <span class="admin-account__sub">创建于 <%= account.createdAt %> · 密码更新于 <%= account.passwordUpdatedAt %></span>
      </div>
      <div class="admin-account__badges">
        <% if (account.isCurrent) { %><span class="admin-badge">当前账号</span><% } %>
        <% if (account.locked) { %>
        <span class="admin-badge admin-badge--locked">已锁定至 <%= account.lockedUntil %></span>
        <% } else if (account.mustChangePassword) { %>
        <span class="admin-badge admin-badge--warn">使用初始密码</span>
        <% } else { %>
        <span class="admin-badge admin-badge--ok">正常</span>
        <% } %>
        <% if (account.failedAttempts > 0) { %>
        <span class="admin-badge admin-badge--warn">失败 <%= account.failedAttempts %> 次</span>
        <% } %>
      </div>
    </header>

    <div class="admin-account__body">
      <form class="admin-account__reset" method="post" action="/admin/accounts/<%= account.id %>/password">
        <label>重置密码
          <input type="password" name="password" placeholder="新密码（至少 8 位）" required minlength="8" maxlength="200" autocomplete="new-password">
        </label>
        <label>确认
          <input type="password" name="confirm" placeholder="再次输入" required minlength="8" maxlength="200" autocomplete="new-password">
        </label>
        <button class="admin-btn admin-btn--small" type="submit">重置并解锁</button>
      </form>

      <div class="admin-account__actions">
        <% if (account.locked || account.failedAttempts > 0) { %>
        <form method="post" action="/admin/accounts/<%= account.id %>/unlock">
          <button class="admin-btn admin-btn--small" type="submit">解除锁定</button>
        </form>
        <% } %>
        <% if (!account.isCurrent) { %>
        <form method="post" action="/admin/accounts/<%= account.id %>/delete" data-confirm="确定删除管理员「<%= account.username %>」？">
          <button class="admin-btn admin-btn--small admin-btn--danger" type="submit">删除账号</button>
        </form>
        <% } else { %>
        <span class="admin-muted">当前登录账号不能删除</span>
        <% } %>
      </div>
    </div>
  </article>
  <% }) %>
</section>

<%- include('partials/bottom') %>
