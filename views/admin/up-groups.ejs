<%- include('partials/top') %>

<section class="admin-page-head">
  <div>
    <p class="admin-eyebrow">HOME / CREATORS</p>
    <h1>UP 主分组</h1>
    <p>首页「推荐 B 站 UP 主」的筛选分组与卡片。每组至少保留一位 UP 主时页面最完整。</p>
  </div>
</section>

<form class="admin-inline-card" method="post" action="/admin/up-groups">
  <div>
    <b>新增分组</b>
    <span>例如：攻略组、萌新组、竞技场组。</span>
  </div>
  <input type="text" name="name" placeholder="分组名称" required maxlength="60">
  <button class="admin-btn admin-btn--primary" type="submit">+ 添加分组</button>
</form>

<% if (!groups.length) { %>
<div class="admin-empty admin-empty--card">还没有分组，先在上方添加一个。</div>
<% } %>

<% groups.forEach((group) => { %>
<section class="admin-card">
  <header class="admin-card__head">
    <div class="admin-card__title">
      <h2><%= group.name %></h2>
      <span><%= group.creators.length %> 位 UP 主</span>
    </div>
    <div class="admin-card__actions">
      <form class="admin-rename" method="post" action="/admin/up-groups/<%= encodeURIComponent(group.name) %>/rename">
        <input type="text" name="name" value="<%= group.name %>" aria-label="分组名称" maxlength="60">
        <button class="admin-btn admin-btn--small" type="submit">改名</button>
      </form>
      <form method="post" action="/admin/up-groups/<%= encodeURIComponent(group.name) %>/delete" data-confirm="确定删除分组「<%= group.name %>」及其中的 <%= group.creators.length %> 位 UP 主？">
        <button class="admin-btn admin-btn--small admin-btn--danger" type="submit">删除分组</button>
      </form>
    </div>
  </header>

  <div class="admin-card__body">
    <div class="admin-subhead">
      <h3>UP 主列表</h3>
      <a class="admin-btn admin-btn--small admin-btn--primary" href="/admin/creators/new?group=<%= encodeURIComponent(group.name) %>">+ 添加 UP 主</a>
    </div>

    <% if (!group.creators.length) { %>
    <p class="admin-empty">这个分组还没有 UP 主。</p>
    <% } else { %>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead><tr><th>头像</th><th>名称</th><th>简介</th><th>链接</th><th class="admin-table__actions">操作</th></tr></thead>
        <tbody>
          <% group.creators.forEach((creator) => { %>
          <tr>
            <td><img class="admin-thumb admin-thumb--round" src="<%= creator.avatar %>" alt=""></td>
            <td><b><%= creator.name %></b></td>
            <td><span class="admin-truncate" title="<%= creator.desc %>"><%= creator.desc %></span></td>
            <td><a class="admin-truncate" href="<%= creator.url %>" target="_blank" rel="noopener" title="<%= creator.url %>"><%= creator.url %></a></td>
            <td class="admin-table__actions">
              <a class="admin-btn admin-btn--small" href="/admin/creators/<%= encodeURIComponent(group.name) %>/<%= creator.index %>/edit">编辑</a>
              <form method="post" action="/admin/creators/<%= encodeURIComponent(group.name) %>/<%= creator.index %>/delete" data-confirm="确定删除「<%= creator.name %>」？">
                <button class="admin-btn admin-btn--small admin-btn--danger" type="submit">删除</button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</section>
<% }) %>

<%- include('partials/bottom') %>
