<%- include('partials/top') %>

<section class="admin-page-head">
  <div>
    <p class="admin-eyebrow">SITE / SETTINGS</p>
    <h1>站点设置</h1>
    <p>这些数据会显示在首页首屏、战况数据与一图流顶部。</p>
  </div>
  <div class="admin-page-head__actions">
    <a class="admin-btn" href="/" target="_blank" rel="noopener">前台预览 ↗</a>
  </div>
</section>

<% if (Object.keys(errors).length) { %>
<div class="admin-alert admin-alert--error">有 <%= Object.keys(errors).length %> 项内容需要修正。</div>
<% } %>

<form class="admin-form" method="post" action="/admin/site">
  <section class="admin-form__section">
    <h2>基本信息</h2>
    <div class="admin-form__fields admin-form__fields--two">
      <div class="admin-field<%= errors.title ? ' has-error' : '' %>">
        <label for="site-title">站点名称</label>
        <input id="site-title" type="text" name="title" value="<%= values.title %>">
      </div>
      <div class="admin-field<%= errors.shortTitle ? ' has-error' : '' %>">
        <label for="site-short">站点简称</label>
        <input id="site-short" type="text" name="shortTitle" value="<%= values.shortTitle %>">
      </div>
      <div class="admin-field<%= errors.version ? ' has-error' : '' %>">
        <label for="site-version">版本号<span class="admin-required">*</span></label>
        <input id="site-version" type="text" name="version" value="<%= values.version %>" placeholder="2026.11">
        <% if (errors.version) { %><p class="admin-error"><%= errors.version %></p><% } %>
      </div>
      <div class="admin-field<%= errors.updated ? ' has-error' : '' %>">
        <label for="site-updated">表格更新日期<span class="admin-required">*</span></label>
        <input id="site-updated" type="text" name="updated" value="<%= values.updated %>" placeholder="2026.11.13">
        <% if (errors.updated) { %><p class="admin-error"><%= errors.updated %></p><% } %>
      </div>
      <div class="admin-field admin-field--wide<%= errors.github ? ' has-error' : '' %>">
        <label for="site-github">GitHub 链接</label>
        <input id="site-github" type="url" name="github" value="<%= values.github %>" placeholder="https://github.com/...">
        <% if (errors.github) { %><p class="admin-error"><%= errors.github %></p><% } %>
      </div>
      <div class="admin-field admin-field--wide<%= errors.fullGuideImage ? ' has-error' : '' %>">
        <label for="site-full-guide">完整一图流图片<span class="admin-required">*</span></label>
        <div class="admin-imagefield">
          <input id="site-full-guide" type="text" name="fullGuideImage" value="<%= values.fullGuideImage %>"
                 list="site-backgrounds" placeholder="/images/background-image.png" autocomplete="off" data-image-input>
          <datalist id="site-backgrounds">
            <% backgrounds.forEach((option) => { %>
            <option value="<%= option %>"></option>
            <% }) %>
          </datalist>
          <div class="admin-imagefield__row">
            <img class="admin-imagefield__preview" src="<%= values.fullGuideImage || 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==' %>" alt="预览"
                 data-image-preview<%= values.fullGuideImage ? '' : ' hidden' %>>
            <label class="admin-upload">
              <input type="file" accept="image/png,image/jpeg,image/webp,image/gif" data-upload-target="backgrounds" hidden>
              <span>上传图片</span>
            </label>
            <span class="admin-upload__status" data-upload-status></span>
          </div>
        </div>
        <% if (errors.fullGuideImage) { %><p class="admin-error"><%= errors.fullGuideImage %></p><% } %>
        <p class="admin-hint">一图流页面右上角「完整一图流」按钮打开的整图。</p>
      </div>
    </div>
  </section>

  <section class="admin-form__section">
    <h2>版本数据</h2>
    <div class="admin-form__fields admin-form__fields--four">
      <div class="admin-field<%= errors.levelCap ? ' has-error' : '' %>">
        <label for="site-level">等级上限<span class="admin-required">*</span></label>
        <input id="site-level" type="number" min="1" name="levelCap" value="<%= values.levelCap %>">
        <% if (errors.levelCap) { %><p class="admin-error"><%= errors.levelCap %></p><% } %>
      </div>
      <div class="admin-field<%= errors.weaponCap ? ' has-error' : '' %>">
        <label for="site-weapon">专武上限<span class="admin-required">*</span></label>
        <input id="site-weapon" type="number" min="1" name="weaponCap" value="<%= values.weaponCap %>">
        <% if (errors.weaponCap) { %><p class="admin-error"><%= errors.weaponCap %></p><% } %>
      </div>
      <div class="admin-field<%= errors.rankMax ? ' has-error' : '' %>">
        <label for="site-rank-max">最高装备 Rank<span class="admin-required">*</span></label>
        <input id="site-rank-max" type="number" min="1" name="rankMax" value="<%= values.rankMax %>">
        <% if (errors.rankMax) { %><p class="admin-error"><%= errors.rankMax %></p><% } %>
      </div>
      <div class="admin-field<%= errors.rankMin ? ' has-error' : '' %>">
        <label for="site-rank-min">最低装备 Rank<span class="admin-required">*</span></label>
        <input id="site-rank-min" type="number" min="1" name="rankMin" value="<%= values.rankMin %>">
        <% if (errors.rankMin) { %><p class="admin-error"><%= errors.rankMin %></p><% } %>
      </div>
    </div>
  </section>

  <div class="admin-form__actions">
    <button class="admin-btn admin-btn--primary" type="submit">保存设置</button>
  </div>
</form>

<%- include('partials/bottom') %>
