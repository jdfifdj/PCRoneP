<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#fff8f0">
  <meta name="description" content="公主连结 Re:Dive 工会战简单 SET 刀作业合集，按 D1–D5 分类，附作者视频攻略。">
  <title>公主连结<%= month %>月简单SET刀推荐 | PCR ARCHIVE</title>
  <link rel="icon" href="/images/icons/水黑.png" type="image/png">
  <link rel="stylesheet" href="/css/base.css?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/css/pcroneghz.css?v=<%= assetVersion %>">
</head>
<body>
  <div id="app" class="app">

    <header class="topbar">
      <a class="brand" href="/" aria-label="公主连结攻略档案 首页">
        <img src="/images/logo/pcr-logo.png" alt="公主连结 Re:Dive" width="949" height="225">
      </a>
      <span class="topbar__divider" aria-hidden="true"></span>
      <div class="page-id">
        <b>工会战 SET 刀</b>
        <span>CLAN BATTLE / SET</span>
      </div>
      <div class="topbar__right">
        <span class="live"><i aria-hidden="true"></i>当前时间</span>
        <span class="clock"><span data-clock><%= clock %></span><em>UTC+8</em></span>
        <a class="back" href="/">返回首页 <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <main class="workspace">

      <section class="topline">
        <div class="topline__title">
          <span class="topline__num" aria-hidden="true"><%= month %></span>
          <div>
            <p class="eyebrow">MONTHLY CLAN BATTLE / CN SERVER</p>
            <h1><%= month %>月 简单 SET 刀</h1>
            <p class="sub">点击任意作业查看原图 · 按 D1–D5 和 简单分刀 分档整理</p>
          </div>
        </div>
        <div class="topline__right">
          <span class="chip"><i class="dot dot--blue"></i>阶段 <b><%= totalStages %></b></span>
          <span class="chip"><i class="dot dot--pink"></i>作业 <b><%= totalImages %></b></span>
          <span class="chip"><i class="dot dot--gold"></i>作者 <b><%= creators.length %></b></span>
        </div>
      </section>

      <section class="stagebar" aria-label="阶段切换">
        <span class="stagebar__label"><b>阶段</b>STAGE</span>
        <nav class="stagebar__tabs" role="tablist" aria-label="作业阶段">
          <% stages.forEach((stage) => { %>
          <button type="button" class="stage<%= stage.active ? ' is-active' : '' %>" data-stage="<%= stage.index %>"
                  role="tab" aria-selected="<%= stage.active ? 'true' : 'false' %>">
            <%= stage.name %><em><%= stage.count %></em>
          </button>
          <% }) %>
        </nav>
        <span class="stagebar__hint">点击切换 · 图片可点击查看原图</span>
      </section>

      <section class="panel">
        <header class="panel__head">
          <span class="panel__idx">01</span>
          <h2>作业图</h2>
          <span class="panel__en">SET TEAMS</span>
          <span class="panel__count"><%= totalImages %></span>
        </header>
        <div class="panel__body">
          <% if (totalImages) { %>
          <% stages.forEach((stage) => { %>
          <div class="teams<%= stage.name.includes('分刀') ? ' teams--two' : '' %>"
               data-stage-panel="<%= stage.index %>"<%= stage.active ? '' : ' hidden' %>>
            <% stage.images.forEach((image) => { %>
            <button type="button" class="team" title="<%= stage.name %> 作业 <%= image.no %>"
                    data-image="<%= image.src %>"
                    data-caption="<%= stage.name %> · <%= image.no %> / <%= String(stage.count).padStart(2, '0') %>">
              <img src="<%= image.thumb %>" alt="<%= stage.name %> 第 <%= image.no %> 份作业" loading="lazy">
              <span class="team__no"><%= image.no %></span>
              <span class="team__day"><%= stage.name %></span>
            </button>
            <% }) %>
          </div>
          <% }) %>
          <% } else { %>
          <p class="empty">该阶段暂无作业</p>
          <% } %>
        </div>
      </section>

      <section class="panel">
        <header class="panel__head">
          <span class="panel__idx">02</span>
          <h2>视频攻略</h2>
          <span class="panel__en">CREATORS</span>
          <span class="panel__count"><%= creators.length %></span>
        </header>
        <div class="panel__body">
          <div class="authors">
            <% creators.forEach((creator) => { %>
            <a class="creator" href="<%= creator.url %>" target="_blank" rel="noopener noreferrer">
              <span class="creator__avatar">
                <img src="<%= creator.cover %>" alt="<%= creator.name %>" loading="lazy">
              </span>
              <span class="creator__body">
                <b class="creator__name" title="<%= creator.name %>"><%= creator.name %></b>
                <span class="creator__tag"><%= creator.tag %></span>
              </span>
              <i class="creator__arrow" aria-hidden="true">↗</i>
            </a>
            <% }) %>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <span>简单 SET 刀 · 展示版</span>
      <span class="footer__dot" aria-hidden="true"></span>
      <span>资料：<a href="https://space.bilibili.com/189151967" target="_blank" rel="noopener">汐汐的奇幻历险</a> /
        <a href="https://space.bilibili.com/296496909" target="_blank" rel="noopener">玩具喵Official</a> /
        <a href="https://space.bilibili.com/549739" target="_blank" rel="noopener">玖璃梦_花舞组</a></span>
      <span class="footer__dot" aria-hidden="true"></span>
      <a href="<%= site.github %>" target="_blank" rel="noopener">项目 Github ↗</a>
      <span class="footer__clock">SYNC <span data-clock><%= clock %></span></span>
    </footer>

    <%- include('partials/modal') %>
  </div>

  <script src="/js/time.js?v=<%= assetVersion %>"></script>
  <script src="/js/app.js?v=<%= assetVersion %>"></script>
  <script src="/js/pcroneghz.js?v=<%= assetVersion %>"></script>
</body>
</html>
