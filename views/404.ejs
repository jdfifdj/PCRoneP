<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>404 — PCR ARCHIVE</title>
  <link rel="icon" href="/images/icons/水吃.png" type="image/png">
  <link rel="stylesheet" href="/css/base.css?v=<%= assetVersion %>">
  <style>
    body { margin: 0; min-height: 100svh; display: grid; place-items: center; background: #fff8f0; color: #26364f; font-family: "PingFang SC", "Microsoft YaHei", sans-serif; }
    .wrap { text-align: center; padding: 2rem; }
    .code { font-family: "Arial Black", Impact, sans-serif; font-size: clamp(4rem, 16vw, 9rem); line-height: 1; color: #f1528b; margin: 0; }
    h1 { font-size: 1.2rem; letter-spacing: .08em; margin: 1rem 0 .6rem; }
    p { color: #5f6f86; font-size: .9rem; margin: 0 0 1.6rem; }
    a { display: inline-block; padding: .7em 1.4em; border-radius: 999px; background: #f1528b; color: #fff; text-decoration: none; font-size: .85rem; }
  </style>
</head>
<body>
  <div class="wrap">
    <p class="code">404</p>
    <h1>档案不存在</h1>
    <p><%= path %> 未收录于本站。</p>
    <a href="/">返回首页</a>
  </div>
</body>
</html>
